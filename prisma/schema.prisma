generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model detail_pesanan {
  id_detail    Int     @id @default(autoincrement())
  id_pesanan   Int
  id_menu      Int
  jumlah       Int     @default(1)
  harga_satuan Int
  subtotal     Int
  catatan_item String? @db.VarChar(255)
  menu         menu    @relation(fields: [id_menu], references: [id_menu], map: "fk_det_menu")
  pesanan      pesanan @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: Cascade, map: "fk_det_pesanan")

  @@index([id_menu], map: "fk_detail_menu")
  @@index([id_pesanan], map: "fk_detail_pesanan")
}

model kategori {
  id_kategori   Int       @id @default(autoincrement())
  nama_kategori String    @unique(map: "nama_kategori") @db.VarChar(50)
  urutan_tampil Int       @default(0)
  dibuat_pada   DateTime? @default(now()) @db.Timestamp(0)
  menu          menu[]
}

model meja {
  id_meja     Int              @id @default(autoincrement())
  nomor_meja  String           @unique(map: "nomor_meja") @db.VarChar(10)
  kode_qr     String           @unique(map: "kode_qr") @db.VarChar(30)
  status_meja meja_status_meja @default(tersedia)
  dibuat_pada DateTime?        @default(now()) @db.Timestamp(0)
  pesanan     pesanan[]
}

model menu {
  id_menu         Int              @id @default(autoincrement())
  id_kategori     Int
  nama_menu       String           @db.VarChar(100)
  catatan_singkat String?          @db.VarChar(100)
  deskripsi       String?          @db.Text
  harga           Int
  gambar_menu     String?          @db.VarChar(255)
  unggulan        Boolean          @default(false)
  tersedia        Boolean          @default(true)
  dibuat_pada     DateTime?        @default(now()) @db.Timestamp(0)
  diperbarui_pada DateTime?        @default(now()) @db.Timestamp(0)
  detail_pesanan  detail_pesanan[]
  kategori        kategori         @relation(fields: [id_kategori], references: [id_kategori], map: "fk_menu_kategori")

  @@index([id_kategori], map: "fk_menu_kategori")
}

model pesanan {
  id_pesanan      Int                    @id @default(autoincrement())
  nomor_pesanan   String                 @unique(map: "nomor_pesanan") @db.VarChar(30)
  id_meja         Int
  id_kasir        Int?
  nama_pemesan    String                 @db.VarChar(100)
  catatan_pesanan String?                @db.Text
  total_harga     Int                    @default(0)
  metode_bayar    pesanan_metode_bayar   @default(qris)
  status_bayar    pesanan_status_bayar   @default(menunggu_bayar)
  status_pesanan  pesanan_status_pesanan @default(menunggu_bayar)
  dibuat_pada     DateTime?              @default(now()) @db.Timestamp(0)
  diperbarui_pada DateTime?              @default(now()) @db.Timestamp(0)
  detail_pesanan  detail_pesanan[]
  kasir           kasir?                 @relation(fields: [id_kasir], references: [id_kasir], map: "fk_pesanan_kasir")
  meja            meja                   @relation(fields: [id_meja], references: [id_meja], map: "fk_pesanan_meja")

  @@index([id_kasir], map: "fk_pesanan_kasir")
  @@index([id_meja], map: "fk_pesanan_meja")
}

model kasir {
  id_kasir    Int       @id @default(autoincrement())
  nama_kasir  String    @db.VarChar(100)
  username    String    @unique(map: "username") @db.VarChar(50)
  kata_sandi  String    @db.VarChar(255)
  aktif       Boolean   @default(true)
  dibuat_pada DateTime? @default(now()) @db.Timestamp(0)
  pesanan     pesanan[]
}

enum meja_status_meja {
  tersedia
  terisi
}

enum pesanan_metode_bayar {
  qris
  tunai
}

enum pesanan_status_bayar {
  menunggu_bayar
  lunas
}

enum pesanan_status_pesanan {
  menunggu_bayar
  diproses
  siap_saji
  selesai
  dibatalkan
}